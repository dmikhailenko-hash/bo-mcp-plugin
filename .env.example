# Configuration for the traderevolution-bo MCP server.
#
# Copy this file to .env in the plugin root and fill in the three required
# values below. .env is git-ignored — your password never leaves this machine
# except to the BO server you point at.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# Then check everything works:
#
#   python server/setup_check.py


# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your Back-Office API base URL: scheme, host, port and basePath, no trailing
# slash. This is the Swagger "host" + "basePath", NOT the URL of the Swagger
# page itself. If your Swagger UI lives at
#   https://my-bo.example.com:8443/proftrading/rest/swagger-ui.html
# then the value here is
#   https://my-bo.example.com:8443/proftrading/rest
TR_BO_BASE_URL=https://un-demo.traderevolution.com:8443/proftrading/rest

# Your own back-office login. Use your personal account, not a shared one:
# every request is made as you, so BO permissions and audit records stay
# per-person.
TR_BO_LOGIN=
TR_BO_PASSWORD=


# ---------------------------------------------------------------------------
# Guardrails — leave both false unless you have a specific reason
# ---------------------------------------------------------------------------

# false = GET only. true permits POST, PUT, PATCH and DELETE.
TR_BO_ALLOW_WRITES=false

# false = money movement, user and account deletion, password resets and
# position rollbacks stay blocked even when writes are on. Enable only against
# a demo or test server.
TR_BO_ALLOW_DANGEROUS=false

# Reports listed in server/reports.visibility.json as leftover clutter — dated
# snapshots, (copy) duplicates, superseded versions, someone's test — are hidden
# from the report tools. Set this to true to reach them anyway, for maintenance.
#
# Which real reports a person can see is decided by the Back Office itself, from
# their own permissions. This setting does not widen that.
TR_BO_SHOW_ALL_REPORTS=false


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Set to true only when the BO server presents a self-signed certificate,
# which is common on demo and test stands.
TR_BO_INSECURE_TLS=false

#   TR_BO_SPEC_PATH     local swagger.json; default server/swagger.cache.json
#   TR_BO_CATALOG_PATH  local report catalogue; default server/reports.catalog.json
#   TR_BO_TIMEOUT       per-request timeout in seconds, default 30
#   TR_BO_ENV_FILE      read this file instead of searching for .env
#   TR_BO_PYTHON        interpreter the plugin launches; "python3" on macOS/Linux
# TR_BO_SPEC_PATH=
# TR_BO_CATALOG_PATH=
# TR_BO_TIMEOUT=30
# TR_BO_ENV_FILE=
# TR_BO_PYTHON=python3
